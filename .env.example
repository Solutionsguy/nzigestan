# ============================================================
# THE REPUBLIC OF NZIGESTAN — ENVIRONMENT CONFIGURATION (v5.0)
# ============================================================
# IMPORTANT: Never commit .env.local to version control.
# After rotating any secret, update this file and notify the team.
# ============================================================

# --- Safaricom Daraja 2.0 (M-Pesa) ---
# Rotate these keys annually or if compromised.
# Sandbox keys are safe for development; production requires live credentials.
DARAJA_ENVIRONMENT="sandbox" # sandbox | production
DARAJA_CONSUMER_KEY="your_safaricom_consumer_key"
DARAJA_CONSUMER_SECRET="your_safaricom_consumer_secret"
DARAJA_SHORTCODE="174379" # 522522 in production
DARAJA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
DARAJA_CALLBACK_URL="https://nzigestan.com/api/mpesa/callback"

# --- YouTube Data API v3 ---
# Get your key at: https://console.cloud.google.com/apis/credentials
# Channel ID: UCkisiangani_official (replace with actual channel ID)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID="UCkisiangani_official"

# --- WebSub (PubSubHubbub) Live Listener ---
WEBSUB_CALLBACK_URL="https://nzigestan.com/api/websub/callback"

# --- SMS Gateway (Africa's Talking / Safaricom) ---
SMS_API_KEY="your_africas_talking_api_key"
SMS_USERNAME="nzigestan"
SMS_SENDER_ID="NZIGESTAN"

# --- Database (PostgreSQL) ---
# Required for production. Leave empty for local development with in-memory fallback.
DATABASE_URL="postgresql://user:password@localhost:5432/nzigestan"

# --- Admin & App Authentication ---
# This secret protects /admin mutations. Rotate if leaked.
ADMIN_AUTH_SECRET="your_super_secret_admin_key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
